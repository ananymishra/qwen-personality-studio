# Normalize line endings: LF in the repo for all text files
* text=auto eol=lf

# Source code
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.svg text eol=lf

# Windows scripts may keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.woff2 binary
